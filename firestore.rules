rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function email() { return request.auth.token.email.lower(); }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(email())) && get(/databases/$(database)/documents/admins/$(email())).data.active == true; }
    function productValid() {
      let d = request.resource.data;
      return d.keys().hasAll(['name','unit','price','active','createdAt','updatedAt']) && d.keys().hasOnly(['name','unit','price','dealerPrice','active','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 30
        && d.price is number && d.price >= 0 && d.price <= 1000000000000
        && (d.get('dealerPrice', null) == null || (d.dealerPrice is number && d.dealerPrice >= 0 && d.dealerPrice <= 1000000000000))
        && d.active is bool && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /products/{id} {
      allow read: if resource.data.active == true || admin();
      allow create: if admin() && productValid() && request.resource.data.createdAt == request.time;
      allow update: if admin() && productValid() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }
    match /admins/{id} {
      allow get: if signedIn() && id == email() || admin();
      allow list: if admin();
      allow create: if admin() && request.resource.data.keys().hasAll(['email','active','createdAt']) && request.resource.data.keys().hasOnly(['email','active','createdAt']) && request.resource.data.email == id && id.matches('^[a-z0-9._%+-]+@gmail[.]com$') && request.resource.data.active is bool && request.resource.data.createdAt == request.time;
      allow update: if admin() && id != email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active is bool;
      allow delete: if admin() && id != email();
    }
  }
}
