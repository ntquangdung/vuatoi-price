rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function email() { return request.auth.token.email.lower(); }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(email())) && get(/databases/$(database)/documents/admins/$(email())).data.active == true; }
    function historyRetentionDays() {
      return exists(/databases/$(database)/documents/settings/history)
        ? get(/databases/$(database)/documents/settings/history).data.retentionDays
        : 7;
    }
    function productValid() {
      let d = request.resource.data;
      return d.keys().hasAll(['name','unit','price','active','createdAt','updatedAt']) && d.keys().hasOnly(['name','unit','price','dealerPrice','active','createdAt','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 30
        && d.price is number && d.price >= 0 && d.price <= 1000000000000
        && (d.get('dealerPrice', null) == null || (d.dealerPrice is number && d.dealerPrice >= 0 && d.dealerPrice <= 1000000000000))
        && d.active is bool && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /products/{id} {
      allow read: if resource.data.active == true || admin();
      allow create: if admin() && productValid() && request.resource.data.createdAt == request.time;
      allow update: if admin() && productValid() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }
    function calculationValid() {
      let d = request.resource.data;
      return d.keys().hasAll(['sections','lineCount','retailSubtotal','discountType','discountValue','discountAmount','total','dealerTotal','savedBy','createdAt'])
        && d.keys().hasOnly(['sections','lineCount','retailSubtotal','discountType','discountValue','discountAmount','total','dealerTotal','savedBy','createdAt'])
        && d.sections is list && d.sections.size() == 1
        && d.lineCount is int && d.lineCount > 0 && d.lineCount <= 100
        && d.retailSubtotal is number && d.retailSubtotal >= 0 && d.retailSubtotal <= 1000000000000000
        && d.discountType in ['percent','amount']
        && d.discountValue is number && d.discountValue >= 0 && d.discountValue <= 1000000000000
        && d.discountAmount is number && d.discountAmount >= 0 && d.discountAmount <= d.retailSubtotal
        && d.total is number && d.total == d.retailSubtotal - d.discountAmount
        && (d.dealerTotal == null || (d.dealerTotal is number && d.dealerTotal >= 0 && d.dealerTotal <= 1000000000000000))
        && d.savedBy == email() && d.createdAt == request.time;
    }
    match /calculations/{id} {
      allow read: if admin();
      allow create: if signedIn() && calculationValid();
      allow update: if false;
      allow delete: if admin() && resource.data.createdAt <= request.time - duration.value(historyRetentionDays(), 'd');
    }
    match /settings/history {
      allow get: if admin();
      allow list: if false;
      allow create, update: if admin()
        && request.resource.data.keys().hasAll(['retentionDays','updatedAt'])
        && request.resource.data.keys().hasOnly(['retentionDays','updatedAt'])
        && request.resource.data.retentionDays in [3,7,10,30]
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /admins/{id} {
      allow get: if signedIn() && id == email() || admin();
      allow list: if admin();
      allow create: if admin() && request.resource.data.keys().hasAll(['email','active','createdAt']) && request.resource.data.keys().hasOnly(['email','active','createdAt']) && request.resource.data.email == id && id.matches('^[a-z0-9._%+-]+@gmail[.]com$') && request.resource.data.active is bool && request.resource.data.createdAt == request.time;
      allow update: if admin() && id != email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']) && request.resource.data.active is bool;
      allow delete: if admin() && id != email();
    }
  }
}
